# ╔══════════════════════════════════════════════════════════════════════╗
# ║  FinTrack — Variáveis de Ambiente                                  ║
# ║  Copie este arquivo para .env e preencha com suas credenciais.     ║
# ║  Veja o README.md para instruções detalhadas.                      ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Firebase (obrigatórias) ──────────────────────────────────────────
# Encontre estes valores em: Firebase Console → Configurações do projeto
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase (opcionais) ─────────────────────────────────────────────
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ── Google Gemini AI (opcional — habilita OCR de cupons) ─────────────
# Obtenha em: https://ai.google.dev/
GEMINI_API_KEY=

# ── Modelo Gemini (opcional — padrão: gemini-2.5-flash) ─────────────
# GEMINI_MODEL=gemini-2.5-flash
